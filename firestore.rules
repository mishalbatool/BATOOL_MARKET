rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation ping endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // Admins registry:
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Products:
    // Read: Anyone (customers, visitors, across all devices) can read the products
    // Write: Allow create, update, delete for store operations
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
